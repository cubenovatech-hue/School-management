# Copy this file to .env and fill in your own values

# Local MongoDB:      mongodb://127.0.0.1:27017/school_crm
# MongoDB Atlas (free): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/school_crm
MONGODB_URI=mongodb://127.0.0.1:27017/school_crm

# Any long random string
JWT_SECRET=change_this_to_a_long_random_string

PORT=5000

 
# --- Email (Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_GMAIL_ADDRESS_HERE@gmail.com
SMTP_PASS=YOUR_16_CHAR_APP_PASSWORD_NO_SPACES
FROM_EMAIL=YOUR_GMAIL_ADDRESS_HERE@gmail.com
FROM_NAME=Northfield School
